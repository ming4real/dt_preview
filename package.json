{
  "publisher": "SiliconBlade",
  "name": "dtb-editor",
  "displayName": "Device Tree Editor",
  "description": "Device Tree Editor - Live Preview of merged sources",
  "icon": "images/icon.png",
  "version": "0.2.4",
  "engines": {
    "vscode": "^1.125.0"
  },
  "keywords": [
    "device tree",
    "dts",
    "dtsi",
    "dtb",
    "linux",
    "embedded",
    "embedded linux",
    "kernel",
    "arm",
    "zephyr",
    "yocto",
    "nxp",
    "stm32",
    "raspberry pi"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ming4real/dt_preview.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dtbEditor.previewThisDtsAsRoot",
        "title": "Device Tree Editor: Preview DTS"
      },
      {
        "command": "dtbEditor.useActiveEditorAsRoot",
        "title": "Use Active Editor as Root"
      }
    ],
    "menus": {
      "webview/title": [
        {
          "command": "dtbEditor.useActiveEditorAsRoot",
          "when": "webviewId == 'deviceTreePreview'",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/esbuild.js",
    "watch": "node scripts/watch.js",
    "package": "vsce package",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "monaco-editor": "^0.55.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
